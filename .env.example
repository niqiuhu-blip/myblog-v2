# PostgreSQL Docker image (for production, use TCR mirror: ccr.ccs.tencentyun.com/your-namespace/postgres:16-alpine)
POSTGRES_IMAGE=postgres:16-alpine

# Database
DATABASE_URL="postgresql://myblog:myblog_dev_password@localhost:5432/myblog?schema=public"
POSTGRES_USER=myblog
POSTGRES_PASSWORD=myblog_dev_password
POSTGRES_DB=myblog

# JWT (generate a secure one for production: openssl rand -hex 32)
JWT_SECRET="your-super-secret-jwt-key-change-this-in-production"

# Node environment
NODE_ENV=development
PORT=4000

# CORS
CORS_ORIGIN="http://localhost:3000"
