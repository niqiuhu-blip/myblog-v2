# Database
DATABASE_URL="postgresql://myblog:myblog_dev_password@localhost:5432/myblog?schema=public"
POSTGRES_USER=myblog
POSTGRES_PASSWORD=myblog_dev_password
POSTGRES_DB=myblog
# PostgreSQL image mirror for Docker Compose
# Replace with your Tencent Cloud TCR or other domestic registry image
POSTGRES_IMAGE="ccr.ccs.tencentyun.com/your-namespace/postgres:16-alpine"

# JWT (generate a secure one for production: openssl rand -hex 32)
JWT_SECRET="your-super-secret-jwt-key-change-this-in-production"

# Node environment
NODE_ENV=development
PORT=4000

# CORS
CORS_ORIGIN="http://localhost:3000"
